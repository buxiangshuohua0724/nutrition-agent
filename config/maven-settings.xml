<?xml version="1.0" encoding="UTF-8"?>
<!--
  =============================================================================
  nutrition-agent 构建用 Maven settings
  =============================================================================
  为什么需要这个文件：

  本机的全局 settings.xml 指向两个不可用的位置，导致 `mvn compile` 直接失败：
    1) <localRepository> 指向 C:\Users\16148\.maven\apache-maven-3.8.5\mvn_repo，
       该目录是空的；实际可用的依赖缓存全在 C:\Users\16148\.m2\repository。
    2) <mirror> 把 central 镜像到 http://maven.aliyun.com/...（id=alimaven），
       而该地址在当前网络下连接被重置（无法下载任何依赖）。
       更麻烦的是：离线缓存里的 _remote.repositories 记录来源为 `central`，
       与 mirror 的 id `alimaven` 不一致，Maven 会认为「该构件从未从 alimaven
       下载过」，于是在离线模式下也拒绝使用它们
       （报错：... has not been downloaded from it before）。

  解法：把 central 镜像到 **id 也为 `central`** 的地址。这样缓存中标注
  `>central=` 的构件与当前仓库 id 匹配，离线可直接命中；一旦网络可达，
  也能正常下载缺失构件，不需要 `-o` 或 `-llr` 这类降级开关。

  用法（在 backend/ 目录下）：
    mvn -s ../config/maven-settings.xml compile
    mvn -s ../config/maven-settings.xml test
    mvn -s ../config/maven-settings.xml spring-boot:run -Dspring-boot.run.profiles=dev
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">

  <!--
    localRepository 指向系统真实的 Maven 缓存 C:\Users\16148\.m2\repository。

    历史：本项目一度把 localRepository 指向项目内的 .m2repo（上面这个缓存的
    2.18 GB 完整副本），原因是当时的 DSH 文件沙箱在 workspace-write 模式下
    禁止写工作区之外的路径，Maven 往 C:\Users\16148\.m2 写
    .lastUpdated / *.part.lock 会被拒绝
      （... plexus-utils-1.1.jar.part.lock (系统找不到指定的路径。)），
    而 Maven 又把这类失败包装成"找不到构件"，把真正原因盖掉了。

    代价是那个副本落在项目目录里，内含 5730 个 .pom —— IntelliJ 会把它们当成
    Maven 工程扫描并导入，Maven 面板因此被几百个 "Netty/BOM" 之类的节点塞满
    （那是 netty-bom 各版本 pom 的 <name>，不是构建里的重复依赖）。
    当前文件策略为 danger-full-access，沙箱不再限制工作区外写入，故改回系统缓存。

    ⚠️ 若以后 DSH 又退回 workspace-write 模式，构建会因无法写
    C:\Users\16148\.m2 而失败。那时把副本拷回来，并把下面这行改回
    D:\ds_harness_work\nutrition-agent\.m2repo 即可：
      robocopy C:\Users\16148\.m2\repository .m2repo /E /MT:16
    （/.m2repo/ 已在 .gitignore 中，不会入库）
  -->
  <localRepository>C:\Users\16148\.m2\repository</localRepository>

  <mirrors>
    <!--
      id 必须与缓存中 _remote.repositories 里记录的一致（即 central），
      否则 Maven 会因为「来源仓库不匹配」而拒绝使用已缓存的构件。
    -->
    <mirror>
      <id>central</id>
      <name>central (aliyun public, id kept as 'central' to match local cache origin)</name>
      <url>https://maven.aliyun.com/repository/public</url>
      <mirrorOf>central</mirrorOf>
    </mirror>
  </mirrors>

  <profiles>
    <profile>
      <id>jdk-release</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
      </properties>
    </profile>
  </profiles>

</settings>
